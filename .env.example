# Generate this value with: npm run auth:hash
APP_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-hash

# Use at least 32 random bytes. For example: openssl rand -base64 48
APP_COOKIE_SECRET=replace-with-a-long-random-secret

# Keep this server-side. The app never sends it to the browser.
OPENAI_API_KEY=replace-with-an-openai-api-key

# Low-latency model for clarity readings and industry classification.
OPENAI_INTAKE_MODEL=gpt-5.6-luna

# Stronger balanced model for cited broad research.
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
